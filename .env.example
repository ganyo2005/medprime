# Copy to .env for local dev, or set these as environment variables through
# cPanel's "Setup Python App" screen in production. Never commit real values.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Change this in production to something only staff know — bots scan for
# "admin/" specifically, so don't deploy with the default below.
ADMIN_URL=staff-portal-change-me/

# Leave DB_HOST empty for local dev (falls back to SQLite). Set it in production.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# Org enrollment is still taken out "for now" — flip to True once the
# subscription pricing/gateway decision for it is settled.
TUTOR_ENABLED=True
TUTOR_LIMIT_PREMIUM=3
ORG_ENROLLMENT_ENABLED=False

# Required for the tutor to actually answer — get this from console.anthropic.com
# (pay-as-you-go billing, separate from a claude.ai Pro subscription).
ANTHROPIC_API_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PRICE_SUB_MONTHLY_GHS=60
PRICE_SUB_SIX_MONTH_GHS=175
PRICE_SUB_YEARLY_GHS=350
ORG_SEAT_PRICE_GHS=50

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Medprime Education Group <no-reply@medprimeeducationgroup.com>
ENQUIRY_NOTIFY_EMAIL=medprimeeducationgroup@gmail.com

# Production only:
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
